# ==============================================================================
# API TESTING PLAYGROUND - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL DOCKER COMPOSE / MYSQL CONFIGURATION
# ------------------------------------------------------------------------------
DB_HOST=localhost
DB_PORT=3306
DB_NAME=api_testing_playground
DB_USER=playground_user
DB_PASSWORD=your_secure_password_here
DB_ROOT_PASSWORD=your_root_password_here

# ------------------------------------------------------------------------------
# 2. BACKEND PROFILE & SERVER CONFIGURATION
# ------------------------------------------------------------------------------
# Active Spring Profile: 'default' (H2 file db), 'mysql', or 'postgres' (Neon)
SPRING_PROFILES_ACTIVE=default
PORT=8080
BACKEND_PORT=8080
FRONTEND_PORT=3000

# ------------------------------------------------------------------------------
# 3. PRODUCTION POSTGRESQL / NEON CONFIGURATION (When SPRING_PROFILES_ACTIVE=postgres)
# ------------------------------------------------------------------------------
# SPRING_DATASOURCE_URL=jdbc:postgresql://<neon-host>.us-east-2.aws.neon.tech/<dbname>?sslmode=require
# SPRING_DATASOURCE_USERNAME=<neon-username>
# SPRING_DATASOURCE_PASSWORD=<neon-password>

# ------------------------------------------------------------------------------
# 4. CORS CONFIGURATION (Comma-separated list of allowed origins)
# ------------------------------------------------------------------------------
# Local development default:
PLAYGROUND_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
# Production Cloudflare Pages example:
# PLAYGROUND_CORS_ALLOWED_ORIGINS=https://api-testing-playground-a36.pages.dev

# ------------------------------------------------------------------------------
# 5. SSRF & OUTBOUND NETWORK SECURITY
# ------------------------------------------------------------------------------
# Local Development: true allows calling the embedded Echo server and local endpoints
# Production Deployment: MUST set to false to block access to internal / private services
PLAYGROUND_ALLOW_LOOPBACK=true
PLAYGROUND_ALLOW_PRIVATE_IPS=true
